{
  "version": "2.0.0",
  "presentation": {
    "echo": true,
    "reveal": "always",
    "focus": false,
    "panel": "dedicated"
  },
  "tasks": [
    {
      "label": "Start Dev Server",
      "type": "shell",
      "command": "python3 ${workspaceFolder}/scripts/dev_frontend.py",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": "." }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "ntfy Alerts dev server",
          "endsPattern": "Shutting down"
        }
      }
    }
  ]
}
